# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///agent_data.db

# LangSmith Configuration (optional - for observability)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=multi-step-agent

# Email Configuration (for future SMTP upgrade)
# Currently mock/print-only. Uncomment to use real SMTP:
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=your_email@gmail.com

# Agent Configuration
LOG_LEVEL=INFO
MAX_REPLANS=3
